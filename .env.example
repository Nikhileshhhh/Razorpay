# MoneyTrace environment template.
# Copy to `.env` and fill in LOCAL / TEST-MODE values only.
# NEVER put real, live, or production secrets in this file or in `.env` committed to source control.
# In demo/buildathon environments, Razorpay keys beginning with `rzp_live_` are rejected at startup.

# Runtime environment: one of demo | buildathon | test | development | production
MONEYTRACE_ENV=demo

# Node runtime hint (development | test | production)
NODE_ENV=development

# HTTP API
API_PORT=3000
API_HOST=127.0.0.1

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL (used by later tasks; not required for MT-001 build/lint/test)
DATABASE_URL=postgres://moneytrace:moneytrace@127.0.0.1:5432/moneytrace

# Razorpay Test Mode credentials (server-side only, optional).
# Must be TEST keys (rzp_test_...). Live keys (rzp_live_...) are rejected in demo/buildathon.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HMAC secret used to authenticate the trusted synthetic source connectors (demo only).
SYNTHETIC_SOURCE_HMAC_SECRET=

# Model provider selection behind the provider-neutral gateway (used by later tasks).
MODEL_PROVIDER=stub
